+// The index of the largest of theVector's values from its lower bound to theUpper, the first
+// on ties, as math_Vector::Max takes over the whole vector: the U loop searches only the
+// current strip's intervals, since the vector keeps a wider earlier strip's past them.
+static Standard_Integer MaxIndex(const math_Vector& theVector, const Standard_Integer theUpper)
+{
+  Standard_Integer anIndex = 0;
+  Standard_Real    aMax    = RealFirst();
+  for (Standard_Integer i = theVector.Lower(); i <= theUpper; ++i)
+  {
+    if (theVector(i) > aMax)
+    {
+      aMax    = theVector(i);
+      anIndex = i;
+    }
+  }
+  return anIndex;
+}
 } // namespace
 
