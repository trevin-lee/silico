{
  "$defs": {
    "Angle": {
      "description": "An angle in degrees: a number, to at most 9 decimals (nanodegrees). An exponent is read exactly; Silico writes plain decimals. (Strings are reserved for expressions, which aren't read yet.)",
      "type": "number"
    },
    "ChamferSize": {
      "additionalProperties": false,
      "description": "How far a chamfer cuts each edge back: along both its faces alike. (The uneven forms,\nmeasured from one of each edge's faces, are left for later: which face is the document's\nto name, not OCCT's order to pick.)",
      "properties": {
        "distance": {
          "$ref": "#/$defs/Length"
        }
      },
      "required": [
        "distance"
      ],
      "type": "object"
    },
    "Coordinate": {
      "description": "A value the solver works out, in millimetres: a number, read correctly rounded to the nearest 64-bit float, and written in full as the shortest decimal that reads back as it. Within a kilometre of the origin.",
      "type": "number"
    },
    "Direction": {
      "description": "How two curves meeting at a point run there: on in the `same` direction (a smooth\njoin), or back the `opposite` way (a cusp).",
      "enum": [
        "same",
        "opposite"
      ],
      "type": "string"
    },
    "ElementId": {
      "description": "A sketch element's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u), unique within its sketch.",
      "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
      "type": "string"
    },
    "ElementName": {
      "description": "An element of an earlier feature's solid, by its name in Silico's form (feature.Kind(...)), never by its number.",
      "minLength": 1,
      "type": "string"
    },
    "Feature": {
      "description": "One feature of the timeline: what it is, its version, and its name.",
      "oneOf": [
        {
          "description": "A box from `position` (its lowest corner), `length` along x, `width` along y, and\n`height` along z.",
          "properties": {
            "height": {
              "$ref": "#/$defs/Length"
            },
            "length": {
              "$ref": "#/$defs/Length"
            },
            "position": {
              "items": {
                "$ref": "#/$defs/Length"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "type": {
              "const": "box",
              "type": "string"
            },
            "width": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "position",
            "length",
            "width",
            "height"
          ],
          "type": "object"
        },
        {
          "description": "A cylinder along z, its base centred on `position`.",
          "properties": {
            "height": {
              "$ref": "#/$defs/Length"
            },
            "position": {
              "items": {
                "$ref": "#/$defs/Length"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "radius": {
              "$ref": "#/$defs/Length"
            },
            "type": {
              "const": "cylinder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "radius",
            "height"
          ],
          "type": "object"
        },
        {
          "description": "A sphere centred on `position`.",
          "properties": {
            "position": {
              "items": {
                "$ref": "#/$defs/Length"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "radius": {
              "$ref": "#/$defs/Length"
            },
            "type": {
              "const": "sphere",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "radius"
          ],
          "type": "object"
        },
        {
          "description": "A cone along z, its base (`radius1`) centred on `position`, `radius2` at `height`.\nEither radius may be zero, not both.",
          "properties": {
            "height": {
              "$ref": "#/$defs/Length"
            },
            "position": {
              "items": {
                "$ref": "#/$defs/Length"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "radius1": {
              "$ref": "#/$defs/Length"
            },
            "radius2": {
              "$ref": "#/$defs/Length"
            },
            "type": {
              "const": "cone",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "radius1",
            "radius2",
            "height"
          ],
          "type": "object"
        },
        {
          "description": "A torus around z, centred on `position`: `radius1` from the axis to the tube's\ncentre, `radius2` the tube's.",
          "properties": {
            "position": {
              "items": {
                "$ref": "#/$defs/Length"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "radius1": {
              "$ref": "#/$defs/Length"
            },
            "radius2": {
              "$ref": "#/$defs/Length"
            },
            "type": {
              "const": "torus",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "radius1",
            "radius2"
          ],
          "type": "object"
        },
        {
          "description": "Everything in either of two features' solids.",
          "properties": {
            "base": {
              "$ref": "#/$defs/FeatureId"
            },
            "tool": {
              "$ref": "#/$defs/FeatureId"
            },
            "type": {
              "const": "fuse",
              "type": "string"
            }
          },
          "required": [
            "type",
            "base",
            "tool"
          ],
          "type": "object"
        },
        {
          "description": "`base`'s solid less what's in `tool`'s.",
          "properties": {
            "base": {
              "$ref": "#/$defs/FeatureId"
            },
            "tool": {
              "$ref": "#/$defs/FeatureId"
            },
            "type": {
              "const": "cut",
              "type": "string"
            }
          },
          "required": [
            "type",
            "base",
            "tool"
          ],
          "type": "object"
        },
        {
          "description": "What's in both of two features' solids.",
          "properties": {
            "base": {
              "$ref": "#/$defs/FeatureId"
            },
            "tool": {
              "$ref": "#/$defs/FeatureId"
            },
            "type": {
              "const": "common",
              "type": "string"
            }
          },
          "required": [
            "type",
            "base",
            "tool"
          ],
          "type": "object"
        },
        {
          "description": "A constrained 2D sketch (docs/design/m3.2-sketch-format.md).",
          "properties": {
            "arcs": {
              "items": {
                "$ref": "#/$defs/SketchArc"
              },
              "type": "array"
            },
            "circles": {
              "items": {
                "$ref": "#/$defs/SketchCircle"
              },
              "type": "array"
            },
            "constraints": {
              "items": {
                "$ref": "#/$defs/SketchConstraint"
              },
              "type": "array"
            },
            "lines": {
              "items": {
                "$ref": "#/$defs/SketchLine"
              },
              "type": "array"
            },
            "plane": {
              "$ref": "#/$defs/Plane"
            },
            "points": {
              "description": "The sketch's points, which its curves share: two curves that meet name the same\npoint.",
              "items": {
                "$ref": "#/$defs/SketchPoint"
              },
              "type": "array"
            },
            "type": {
              "const": "sketch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "plane",
            "points",
            "lines",
            "circles",
            "arcs",
            "constraints"
          ],
          "type": "object"
        },
        {
          "description": "`base`'s solid with `edges` rounded to `radius`.",
          "properties": {
            "base": {
              "$ref": "#/$defs/FeatureId"
            },
            "edges": {
              "items": {
                "$ref": "#/$defs/ElementName"
              },
              "minItems": 1,
              "type": "array"
            },
            "radius": {
              "$ref": "#/$defs/Length"
            },
            "type": {
              "const": "fillet",
              "type": "string"
            }
          },
          "required": [
            "type",
            "base",
            "edges",
            "radius"
          ],
          "type": "object"
        },
        {
          "description": "`base`'s solid with `edges` cut back by `size`.",
          "properties": {
            "base": {
              "$ref": "#/$defs/FeatureId"
            },
            "edges": {
              "items": {
                "$ref": "#/$defs/ElementName"
              },
              "minItems": 1,
              "type": "array"
            },
            "size": {
              "$ref": "#/$defs/ChamferSize"
            },
            "type": {
              "const": "chamfer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "base",
            "edges",
            "size"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint",
          "description": "What the feature's solid measured when it was last built and saved; a rebuild that\nmeasures otherwise is drift (left out when it has none: new, or not built)."
        },
        "id": {
          "$ref": "#/$defs/FeatureId"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "note": {
          "description": "A note about the feature, kept with it (left out when there's none).",
          "type": "string"
        },
        "v": {
          "$ref": "#/$defs/FeatureVersion"
        }
      },
      "required": [
        "id",
        "v",
        "name"
      ],
      "type": "object",
      "unevaluatedProperties": false
    },
    "FeatureId": {
      "description": "A feature's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u).",
      "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
      "type": "string"
    },
    "FeatureVersion": {
      "const": 1,
      "description": "The feature's version: changing a feature type's behaviour bumps it, and a document keeps the behaviour it was made with. 1 for every type so far."
    },
    "Fingerprint": {
      "additionalProperties": false,
      "description": "What a feature's solid measures: its volume and area, its tight bounding box (lowest x, y,\nz, then highest; none for a solid with nothing in it), and how many faces, edges, and\nvertices it has.",
      "properties": {
        "area": {
          "$ref": "#/$defs/Measure"
        },
        "bbox": {
          "description": "`[x, y, z, x, y, z]`: the lowest corner, then the highest (left out when the solid\nhas nothing in it).",
          "items": {
            "$ref": "#/$defs/Length"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "edges": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "faces": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "vertices": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "volume": {
          "$ref": "#/$defs/Measure"
        }
      },
      "required": [
        "volume",
        "area",
        "faces",
        "edges",
        "vertices"
      ],
      "type": "object"
    },
    "FormatVersion": {
      "const": 1,
      "description": "The format's version: 1."
    },
    "Length": {
      "description": "A length in millimetres: a number, to at most 6 decimals (nanometres). An exponent is read exactly; Silico writes plain decimals. (Strings are reserved for expressions, which aren't read yet.)",
      "type": "number"
    },
    "LineSide": {
      "description": "Which side of a line, facing from its start (`from`) to its end (`to`); for an axis,\nfacing along it (+x, +y).",
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "Measure": {
      "description": "A volume (mm³) or area (mm²): a number, to at most 6 decimals.",
      "type": "number"
    },
    "Name": {
      "description": "A display name, which needn't be unique.",
      "minLength": 1,
      "type": "string"
    },
    "Plane": {
      "description": "The plane a sketch is drawn on: one of the origin's, oriented as FreeCAD's (D6). On\n`xy`, the sketch's x is +X and its y +Y (normal +Z); on `xz`, x is +X and y +Z (normal\n−Y); on `yz`, x is +Y and y +Z (normal +X).",
      "enum": [
        "xy",
        "xz",
        "yz"
      ],
      "type": "string"
    },
    "SketchArc": {
      "additionalProperties": false,
      "description": "An arc about `center`, counter-clockwise from `start` to `end`. Its points are its\ndefinition: its radius and angles are the solver's, worked out from them, and the\nsolve holds its ends on it (D2, arcs).",
      "properties": {
        "center": {
          "$ref": "#/$defs/ElementId"
        },
        "construction": {
          "type": "boolean"
        },
        "end": {
          "$ref": "#/$defs/ElementId"
        },
        "id": {
          "$ref": "#/$defs/ElementId"
        },
        "start": {
          "$ref": "#/$defs/ElementId"
        }
      },
      "required": [
        "id",
        "center",
        "start",
        "end",
        "construction"
      ],
      "type": "object"
    },
    "SketchCircle": {
      "additionalProperties": false,
      "description": "A circle about a point.",
      "properties": {
        "center": {
          "$ref": "#/$defs/ElementId"
        },
        "construction": {
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/ElementId"
        },
        "radius": {
          "$ref": "#/$defs/Coordinate",
          "description": "Worked out by the solver, as coordinates are."
        }
      },
      "required": [
        "id",
        "center",
        "radius",
        "construction"
      ],
      "type": "object"
    },
    "SketchConstraint": {
      "description": "One constraint: its ID and its form.",
      "oneOf": [
        {
          "description": "The line parallel to x.",
          "properties": {
            "line": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "horizontal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "line"
          ],
          "type": "object"
        },
        {
          "description": "The line parallel to y.",
          "properties": {
            "line": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "vertical",
              "type": "string"
            }
          },
          "required": [
            "type",
            "line"
          ],
          "type": "object"
        },
        {
          "description": "The two points level.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "horizontal_points",
              "type": "string"
            }
          },
          "required": [
            "type",
            "a",
            "b"
          ],
          "type": "object"
        },
        {
          "description": "One point above the other.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "vertical_points",
              "type": "string"
            }
          },
          "required": [
            "type",
            "a",
            "b"
          ],
          "type": "object"
        },
        {
          "description": "The line's length.",
          "properties": {
            "driving": {
              "type": "boolean"
            },
            "line": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "length",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "line",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "The distance between two points.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "driving": {
              "type": "boolean"
            },
            "type": {
              "const": "distance",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "a",
            "b",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "x(b) − x(a), signed.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "driving": {
              "type": "boolean"
            },
            "type": {
              "const": "distance_x",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "a",
            "b",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "y(b) − y(a), signed.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "driving": {
              "type": "boolean"
            },
            "type": {
              "const": "distance_y",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "a",
            "b",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "The point's distance from the line (extended), on the given side of it.",
          "properties": {
            "driving": {
              "type": "boolean"
            },
            "line": {
              "$ref": "#/$defs/SketchReference"
            },
            "point": {
              "$ref": "#/$defs/SketchReference"
            },
            "side": {
              "$ref": "#/$defs/LineSide"
            },
            "type": {
              "const": "point_line_distance",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "point",
            "line",
            "value",
            "side",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "The point on the curve: a line extended, or an arc's whole circle, as FreeCAD's.",
          "properties": {
            "curve": {
              "$ref": "#/$defs/SketchReference"
            },
            "point": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "on",
              "type": "string"
            }
          },
          "required": [
            "type",
            "point",
            "curve"
          ],
          "type": "object"
        },
        {
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "parallel",
              "type": "string"
            }
          },
          "required": [
            "type",
            "a",
            "b"
          ],
          "type": "object"
        },
        {
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "perpendicular",
              "type": "string"
            }
          },
          "required": [
            "type",
            "a",
            "b"
          ],
          "type": "object"
        },
        {
          "description": "The angle from `a`'s direction to `b`'s, counter-clockwise, signed.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "driving": {
              "type": "boolean"
            },
            "type": {
              "const": "angle",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Angle"
            }
          },
          "required": [
            "type",
            "a",
            "b",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "A circle's or arc's radius.",
          "properties": {
            "curve": {
              "$ref": "#/$defs/SketchReference"
            },
            "driving": {
              "type": "boolean"
            },
            "type": {
              "const": "radius",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "curve",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "A circle's or arc's diameter.",
          "properties": {
            "curve": {
              "$ref": "#/$defs/SketchReference"
            },
            "driving": {
              "type": "boolean"
            },
            "type": {
              "const": "diameter",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Length"
            }
          },
          "required": [
            "type",
            "curve",
            "value",
            "driving"
          ],
          "type": "object"
        },
        {
          "description": "Two lines of equal length, or two circles or arcs of equal radius.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "type": {
              "const": "equal",
              "type": "string"
            }
          },
          "required": [
            "type",
            "a",
            "b"
          ],
          "type": "object"
        },
        {
          "description": "Tangent along their edges: a line and a circle or arc, or two circles or arcs.",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
            },
            "side": {
              "$ref": "#/$defs/TangentSide"
            },
            "type": {
              "const": "tangent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "a",
            "b",
            "side"
          ],
          "type": "object"
        },
        {
          "description": "Tangent where `a` ends on `b`: the point `at`, an end of `a`, lies on `b`, and `a`\nruns there along `b`, its direction leaving `at` the `same` as `b`'s or `opposite`\n(FreeCAD's endpoint-to-edge `Tangent`).",
          "properties": {
            "a": {
              "$ref": "#/$defs/SketchReference"
            },
            "at": {
              "$ref": "#/$defs/SketchReference"
            },
            "b": {
              "$ref": "#/$defs/SketchReference"
