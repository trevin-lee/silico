            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "id": {
                "$ref": "#/$defs/ElementId"
              },
              "state": {
                "$ref": "#/$defs/ConstraintState"
              },
              "type": {
                "const": "distance",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "a",
              "b",
              "driving",
              "id",
              "state",
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "x(b) − x(a), signed.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "id": {
