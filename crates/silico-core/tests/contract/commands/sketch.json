              "type"
            ],
            "type": "object"
          }
        ]
      },
      "SketchDependency": {
        "additionalProperties": false,
        "description": "One dependent group: its constraints' IDs, sorted, and how many it has, as an error's\n`elements` and `elements_total`.",
