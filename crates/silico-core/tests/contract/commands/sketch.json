{
  "request": {
    "$defs": {
      "FeatureId": {
        "description": "A feature's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u).",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      },
      "ModelChoice": {
        "description": "Which model to read: the current one, or the newest published.",
        "oneOf": [
          {
            "const": "current",
            "description": "The session's current revision's model, rebuilt if it isn't yet: what an agent that\njust edited reads.",
            "type": "string"
          },
          {
            "const": "published",
            "description": "The newest model published, which may be an older revision's, read at once: what a\nUI reads while a rebuild runs.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`sketch`'s request: a sketch as the model named solved it.",
    "properties": {
      "model": {
        "$ref": "#/$defs/ModelChoice"
      },
      "session": {
        "description": "The session's ID, as `open` gave it.",
        "pattern": "^s[1-9][0-9]*$",
        "type": "string"
      },
      "sketch": {
        "$ref": "#/$defs/FeatureId",
        "description": "The sketch, by its feature's ID."
      }
    },
    "required": [
      "model",
      "session",
      "sketch"
    ],
    "title": "SketchRequest",
    "type": "object"
  },
  "result": {
    "$defs": {
      "Angle": {
        "description": "An angle in degrees: a number, to at most 9 decimals (nanodegrees). An exponent is read exactly; Silico writes plain decimals. (Strings are reserved for expressions, which aren't read yet.)",
        "type": "number"
      },
      "ConstraintState": {
        "description": "A constraint's state: conflicting (in conflict with others, so the sketch isn't solved); redundant (its equations repeat others': removing it, or one of those it repeats, resolves it); partially_redundant (some of them do); satisfied (on a solved sketch, independent of the others and met, a reference dimension always); or unsolved (on a sketch that wasn't solved, any not flagged).",
        "enum": [
          "satisfied",
          "conflicting",
          "redundant",
          "partially_redundant",
          "unsolved"
        ],
        "type": "string"
      },
      "Coordinate": {
        "description": "A value the solver works out, in millimetres: a number, read correctly rounded to the nearest 64-bit float, and written in full as the shortest decimal that reads back as it. Within a kilometre of the origin.",
        "type": "number"
      },
      "Direction": {
        "description": "How two curves meeting at a point run there: on in the `same` direction (a smooth\njoin), or back the `opposite` way (a cusp).",
        "enum": [
          "same",
          "opposite"
        ],
        "type": "string"
      },
      "ElementId": {
        "description": "A sketch element's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u), unique within its sketch.",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      },
      "Error": {
        "additionalProperties": false,
        "description": "Why a command was refused, or a problem it found, in Silico's error contract: a code, a\nmessage, and, where they apply, the feature, the elements at fault (the first of them, and\nhow many in all), the request's field at fault, the cause, what to do, and the names that\nmight have been meant. Every field is always present: null, or empty, where it doesn't\napply.",
        "properties": {
          "candidates": {
            "description": "What might have been meant, such as the names nearest one that found nothing.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cause": {
            "description": "What lay under it, such as the kernel's own failure, if known.",
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "description": "What kind of error it is: one of Silico's error codes, such as `invalid_input`.",
            "type": "string"
          },
          "elements": {
            "description": "The elements at fault, by name: the first of them, if there are many.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "elements_total": {
            "description": "How many elements are at fault, listed or not.",
            "minimum": 0,
            "type": "integer"
          },
          "feature": {
            "description": "The ID of the feature at fault, if one is.",
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "description": "What went wrong, in a sentence.",
            "type": "string"
          },
          "parameter": {
            "description": "The field at fault, as a dotted path (`position.2`), if one is.",
            "type": [
              "string",
              "null"
            ]
          },
          "suggestion": {
            "description": "What to do about it, if Silico can say.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "candidates",
          "cause",
          "code",
          "elements",
          "elements_total",
          "feature",
          "message",
          "parameter",
          "suggestion"
        ],
        "type": "object"
      },
      "FeatureId": {
        "description": "A feature's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u).",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      },
      "Length": {
        "description": "A length in millimetres: a number, to at most 6 decimals (nanometres). An exponent is read exactly; Silico writes plain decimals. (Strings are reserved for expressions, which aren't read yet.)",
        "type": "number"
      },
      "LineSide": {
        "description": "Which side of a line, facing from its start (`from`) to its end (`to`); for an axis,\nfacing along it (+x, +y).",
        "enum": [
          "left",
          "right"
        ],
        "type": "string"
      },
      "MemberState": {
        "description": "A point's or a curve's state: over_defined when a constraint that over-defines governs it (a point when such a constraint reads its x or y; a curve when one names it, not taking its points' state); otherwise under_defined when any of its values (a curve's own, or its points') is free; otherwise fully_defined.",
        "enum": [
          "under_defined",
          "fully_defined",
          "over_defined"
        ],
        "type": "string"
      },
      "SketchArcRead": {
        "additionalProperties": false,
        "description": "An arc, as the document writes it, with its state.",
        "properties": {
          "center": {
            "$ref": "#/$defs/ElementId"
          },
          "construction": {
            "type": "boolean"
          },
          "end": {
            "$ref": "#/$defs/ElementId"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "start": {
            "$ref": "#/$defs/ElementId"
          },
          "state": {
            "$ref": "#/$defs/MemberState"
          }
        },
        "required": [
          "center",
          "construction",
          "end",
          "id",
          "start",
          "state"
        ],
        "type": "object"
      },
      "SketchCircleRead": {
        "additionalProperties": false,
        "description": "A circle, as the document writes it, at its solved radius, with its state.",
        "properties": {
          "center": {
            "$ref": "#/$defs/ElementId"
          },
          "construction": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "radius": {
            "$ref": "#/$defs/Coordinate",
            "description": "Its radius, as solved (as stored, if the sketch wasn't solved)."
          },
          "state": {
            "$ref": "#/$defs/MemberState"
          }
        },
        "required": [
          "center",
          "construction",
          "id",
          "radius",
          "state"
        ],
        "type": "object"
      },
      "SketchConstraintRead": {
        "description": "A constraint, as the document writes it (its ID, its type, and its form's fields, a reference dimension's value as the solve measured it), with its state.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "The line parallel to x.",
            "properties": {
              "id": {
                "$ref": "#/$defs/ElementId"
              },
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "state": {
                "$ref": "#/$defs/ConstraintState"
              },
              "type": {
                "const": "horizontal",
                "type": "string"
              }
            },
            "required": [
              "id",
              "line",
              "state",
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The line parallel to y.",
            "properties": {
              "id": {
                "$ref": "#/$defs/ElementId"
              },
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "state": {
                "$ref": "#/$defs/ConstraintState"
              },
              "type": {
                "const": "vertical",
                "type": "string"
              }
            },
            "required": [
              "id",
              "line",
              "state",
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The two points level.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "id": {
                "$ref": "#/$defs/ElementId"
              },
              "state": {
                "$ref": "#/$defs/ConstraintState"
              },
              "type": {
                "const": "horizontal_points",
                "type": "string"
              }
            },
            "required": [
              "a",
              "b",
              "id",
              "state",
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "One point above the other.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "id": {
                "$ref": "#/$defs/ElementId"
              },
              "state": {
                "$ref": "#/$defs/ConstraintState"
              },
              "type": {
                "const": "vertical_points",
                "type": "string"
              }
            },
            "required": [
              "a",
              "b",
              "id",
              "state",
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The line's length.",
            "properties": {
              "driving": {
                "type": "boolean"
              },
              "id": {
                "$ref": "#/$defs/ElementId"
              },
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "state": {
                "$ref": "#/$defs/ConstraintState"
              },
              "type": {
                "const": "length",
                "type": "string"
              },
              "value": {
