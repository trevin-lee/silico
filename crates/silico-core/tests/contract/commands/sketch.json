              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The point's distance from the line (extended), on the given side of it.",
            "properties": {
              "driving": {
                "type": "boolean"
              },
              "id": {
                "$ref": "#/$defs/ElementId"
              },
