      "SketchState": {
        "description": "The sketch's state, as SolidWorks names it: under_defined (solved, something free), fully_defined (solved, nothing free; or empty), over_defined (constraints in conflict, so not solved; or solved, with a driving dimension whose value the others fix), no_solution (no algorithm placed it), or invalid (solved only to geometry that can't be built or held).",
        "enum": [
          "under_defined",
          "fully_defined",
          "over_defined",
          "no_solution",
          "invalid"
        ],
        "type": "string"
      },
      "TangentSide": {
        "description": "Where a tangent curve lies: for a line and a circle or arc, the side of the line the\ncurve is on (facing from its start to its end); for two circles or arcs, each outside\nthe other, or one inside the other.",
        "enum": [
          "left",
          "right",
          "outside",
          "inside"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`sketch`'s result: the sketch as the model's rebuild solved it, for sketch mode to draw\nand colour.",
    "properties": {
      "arcs": {
        "description": "Each arc, by ID, as the document writes it.",
        "items": {
          "$ref": "#/$defs/SketchArcRead"
        },
        "type": "array"
      },
      "circles": {
        "description": "Each circle, by ID, as the document writes it, at its solved radius.",
        "items": {
          "$ref": "#/$defs/SketchCircleRead"
        },
        "type": "array"
      },
      "constraints": {
        "description": "Each constraint, by ID, as the document writes it, a reference dimension's value as\nthe solve measured it.",
        "items": {
          "$ref": "#/$defs/SketchConstraintRead"
        },
        "type": "array"
      },
      "dependencies": {
        "description": "Each dependent group of constraints, as the solver's diagnosis finds them: the\nconstraint IDs of one linear dependency among the sketch's equations, sorted, the\ngroups sorted. Removing any one constraint of a group resolves it; which is the\nuser's choice. A driving dimension in any group reads `redundant` and over-defines,\nwhichever constraint the solver dropped. The first 100 groups are listed, each its\nfirst 100 constraints. Empty for an empty sketch, and for one whose constraints the\nsolver never took (geometry that can't be held, before any constraint).",
        "items": {
          "$ref": "#/$defs/SketchDependency"
        },
        "maxItems": 100,
        "type": "array"
      },
      "dependencies_total": {
        "description": "How many dependent groups there are, listed or not.",
        "minimum": 0,
        "type": "integer"
      },
      "dofs": {
        "description": "The degrees of freedom left, as PlaneGCS counts them: 0 when nothing is free,\nnegative when constraints conflict. 0 for an empty sketch.",
        "type": "integer"
      },
      "lines": {
        "description": "Each line, by ID, as the document writes it.",
        "items": {
          "$ref": "#/$defs/SketchLineRead"
        },
        "type": "array"
      },
      "plane": {
        "$ref": "#/$defs/SketchFrame"
      },
      "points": {
        "description": "Each point, by ID, as the document writes it, at its solved place.",
        "items": {
          "$ref": "#/$defs/SketchPointRead"
        },
        "type": "array"
      },
      "profile_problems": {
        "description": "Why the solved sketch makes no profile, each as an error (the first 100, in the\norder they're checked): none if it makes one, or wasn't solved (`solve_problem` says\nwhy).",
        "items": {
          "$ref": "#/$defs/Error"
        },
        "maxItems": 100,
        "type": "array"
      },
      "profile_problems_total": {
        "description": "How many reasons there are, listed or not.",
        "minimum": 0,
        "type": "integer"
      },
      "regions": {
        "description": "The profile's regions, as the profile finds them from the solved curves that aren't\nconstruction geometry (each a face a pad, pocket, revolve, or groove of the sketch\nsweeps), by their outer loops' smallest curve IDs: none if the sketch makes no\nprofile, or wasn't solved.",
        "items": {
          "$ref": "#/$defs/SketchRegion"
        },
        "type": "array"
      },
      "sketch": {
        "$ref": "#/$defs/FeatureId",
        "description": "The sketch, by its feature's ID."
      },
      "solve_problem": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ],
        "description": "Why the sketch wasn't solved, as `check` reports it: a conflict (`over_constrained`),\nno solution (`solve_failed`), or geometry that can't be held (`invalid_result`,\n`invalid_input`). Null when it solved."
      },
      "state": {
        "$ref": "#/$defs/SketchState"
      }
    },
    "required": [
      "arcs",
      "circles",
      "constraints",
      "dependencies",
      "dependencies_total",
      "dofs",
      "lines",
      "plane",
      "points",
      "profile_problems",
      "profile_problems_total",
      "regions",
      "sketch",
      "solve_problem",
      "state"
    ],
    "title": "SketchResult",
    "type": "object"
  }
}
