        "required": [
          "constraints",
          "constraints_total"
        ],
        "type": "object"
      },
      "SketchFrame": {
        "additionalProperties": false,
        "description": "The sketch's plane in global coordinates: its origin, and the directions of its x, its y,\nand its normal (x × y, about which counter-clockwise turns), each a unit vector.",
        "properties": {
          "normal": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "origin": {
            "description": "The sketch's (0, 0), in global coordinates (mm).",
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "x": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "y": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "normal",
          "origin",
          "x",
          "y"
        ],
        "type": "object"
      },
      "SketchLineRead": {
        "additionalProperties": false,
        "description": "A line, as the document writes it, with its state.",
        "properties": {
          "construction": {
            "type": "boolean"
          },
          "from": {
            "$ref": "#/$defs/ElementId"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "state": {
            "$ref": "#/$defs/MemberState"
          },
          "to": {
            "$ref": "#/$defs/ElementId"
          }
        },
        "required": [
          "construction",
          "from",
          "id",
          "state",
          "to"
        ],
        "type": "object"
      },
      "SketchPointRead": {
        "additionalProperties": false,
        "description": "A point, as the document writes it, at its solved place, with its state.",
        "properties": {
          "construction": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "state": {
            "$ref": "#/$defs/MemberState"
          },
          "x": {
            "$ref": "#/$defs/Coordinate",
            "description": "Its x, as solved (as stored, if the sketch wasn't solved)."
          },
          "y": {
            "$ref": "#/$defs/Coordinate",
            "description": "Its y, as solved (as stored, if the sketch wasn't solved)."
          }
        },
        "required": [
          "construction",
          "id",
          "state",
          "x",
          "y"
        ],
        "type": "object"
      },
      "SketchReference": {
        "description": "An element of this sketch, by its ID, or one of the fixed references every sketch has: origin, x_axis (from the origin along +x), y_axis (from the origin along +y).",
        "pattern": "^([0123456789abcdefghjkmnpqrstvwxyz]{8}|origin|x_axis|y_axis)$",
        "type": "string"
      },
      "SketchRegion": {
        "additionalProperties": false,
        "description": "A region of the profile: its outer loop's curves and each hole's, by ID.",
        "properties": {
          "holes": {
            "description": "Each hole's curves, in the order it walks them, clockwise; the holes by their\nsmallest curve IDs.",
            "items": {
              "items": {
                "$ref": "#/$defs/ElementId"
              },
              "type": "array"
            },
            "type": "array"
          },
          "outer": {
            "description": "The outer loop's curves, in the order it walks them, counter-clockwise.",
            "items": {
              "$ref": "#/$defs/ElementId"
            },
            "type": "array"
          }
        },
        "required": [
          "holes",
          "outer"
