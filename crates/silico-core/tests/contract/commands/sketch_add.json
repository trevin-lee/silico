{
  "request": {
    "$defs": {
      "Angle": {
        "description": "An angle in degrees: a number, to at most 9 decimals (nanodegrees). An exponent is read exactly; Silico writes plain decimals. (Strings are reserved for expressions, which aren't read yet.)",
        "type": "number"
      },
      "Coordinate": {
        "description": "A value the solver works out, in millimetres: a number, read correctly rounded to the nearest 64-bit float, and written in full as the shortest decimal that reads back as it. Within a kilometre of the origin.",
        "type": "number"
      },
      "Direction": {
        "description": "How two curves meeting at a point run there: on in the `same` direction (a smooth\njoin), or back the `opposite` way (a cusp).",
        "enum": [
          "same",
          "opposite"
        ],
        "type": "string"
      },
      "ElementId": {
        "description": "A sketch element's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u), unique within its sketch.",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      },
      "FeatureId": {
        "description": "A feature's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u).",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      },
      "Length": {
        "description": "A length in millimetres: a number, to at most 6 decimals (nanometres). An exponent is read exactly; Silico writes plain decimals. (Strings are reserved for expressions, which aren't read yet.)",
        "type": "number"
      },
      "LineSide": {
        "description": "Which side of a line, facing from its start (`from`) to its end (`to`); for an axis,\nfacing along it (+x, +y).",
        "enum": [
          "left",
          "right"
        ],
        "type": "string"
      },
      "SketchArc": {
        "additionalProperties": false,
        "description": "An arc about `center`, counter-clockwise from `start` to `end`. Its points are its\ndefinition: its radius and angles are the solver's, worked out from them, and the\nsolve holds its ends on it (D2, arcs).",
        "properties": {
          "center": {
            "$ref": "#/$defs/ElementId"
          },
          "construction": {
            "type": "boolean"
          },
          "end": {
            "$ref": "#/$defs/ElementId"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "start": {
            "$ref": "#/$defs/ElementId"
          }
        },
        "required": [
          "id",
          "center",
          "start",
          "end",
          "construction"
        ],
        "type": "object"
      },
      "SketchCircle": {
        "additionalProperties": false,
        "description": "A circle about a point.",
        "properties": {
          "center": {
            "$ref": "#/$defs/ElementId"
          },
          "construction": {
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "radius": {
            "$ref": "#/$defs/Coordinate",
            "description": "Worked out by the solver, as coordinates are."
          }
        },
        "required": [
          "id",
          "center",
          "radius",
          "construction"
        ],
        "type": "object"
      },
      "SketchConstraint": {
        "description": "One constraint: its ID and its form.",
        "oneOf": [
          {
            "description": "The line parallel to x.",
            "properties": {
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "horizontal",
                "type": "string"
              }
            },
            "required": [
              "type",
              "line"
            ],
            "type": "object"
          },
          {
            "description": "The line parallel to y.",
            "properties": {
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "vertical",
                "type": "string"
              }
            },
            "required": [
              "type",
              "line"
            ],
            "type": "object"
          },
          {
            "description": "The two points level.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "horizontal_points",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b"
            ],
            "type": "object"
          },
          {
            "description": "One point above the other.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "vertical_points",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b"
            ],
            "type": "object"
          },
          {
            "description": "The line's length.",
            "properties": {
              "driving": {
                "type": "boolean"
              },
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "length",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "line",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "The distance between two points.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "type": {
                "const": "distance",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "x(b) − x(a), signed.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "type": {
                "const": "distance_x",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "y(b) − y(a), signed.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "type": {
                "const": "distance_y",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "The point's distance from the line (extended), on the given side of it.",
            "properties": {
              "driving": {
                "type": "boolean"
              },
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "point": {
                "$ref": "#/$defs/SketchReference"
              },
              "side": {
                "$ref": "#/$defs/LineSide"
              },
              "type": {
                "const": "point_line_distance",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "point",
              "line",
              "value",
              "side",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "The point on the curve: a line extended, or an arc's whole circle, as FreeCAD's.",
            "properties": {
              "curve": {
                "$ref": "#/$defs/SketchReference"
              },
              "point": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "on",
                "type": "string"
              }
            },
            "required": [
              "type",
              "point",
              "curve"
            ],
            "type": "object"
          },
          {
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "parallel",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b"
            ],
            "type": "object"
          },
          {
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "perpendicular",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b"
            ],
            "type": "object"
          },
          {
            "description": "The angle from `a`'s direction to `b`'s, counter-clockwise, signed.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "type": {
                "const": "angle",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Angle"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "A circle's or arc's radius.",
            "properties": {
              "curve": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "type": {
                "const": "radius",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "curve",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "A circle's or arc's diameter.",
            "properties": {
              "curve": {
                "$ref": "#/$defs/SketchReference"
              },
              "driving": {
                "type": "boolean"
              },
              "type": {
                "const": "diameter",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Length"
              }
            },
            "required": [
              "type",
              "curve",
              "value",
              "driving"
            ],
            "type": "object"
          },
          {
            "description": "Two lines of equal length, or two circles or arcs of equal radius.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "equal",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b"
            ],
            "type": "object"
          },
          {
            "description": "Tangent along their edges: a line and a circle or arc, or two circles or arcs.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "side": {
                "$ref": "#/$defs/TangentSide"
              },
              "type": {
                "const": "tangent",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "side"
            ],
            "type": "object"
          },
          {
            "description": "Tangent where `a` ends on `b`: the point `at`, an end of `a`, lies on `b`, and `a`\nruns there along `b`, its direction leaving `at` the `same` as `b`'s or `opposite`\n(FreeCAD's endpoint-to-edge `Tangent`).",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "at": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "direction": {
                "$ref": "#/$defs/Direction"
              },
              "type": {
                "const": "tangent_on",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "at",
              "b",
              "direction"
            ],
            "type": "object"
          },
          {
            "description": "Tangent where two curves meet, at the point `at` they share.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "at": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "direction": {
                "$ref": "#/$defs/Direction"
              },
              "type": {
                "const": "tangent_at",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "at",
              "direction"
            ],
            "type": "object"
          },
          {
            "description": "`a` and `b` mirror each other about a line or a point.",
            "properties": {
              "a": {
                "$ref": "#/$defs/SketchReference"
              },
              "about": {
                "$ref": "#/$defs/SketchReference"
              },
              "b": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "symmetric",
                "type": "string"
              }
            },
            "required": [
              "type",
              "a",
              "b",
              "about"
            ],
            "type": "object"
          },
          {
            "description": "The point midway along the line.",
            "properties": {
              "line": {
                "$ref": "#/$defs/SketchReference"
              },
              "point": {
                "$ref": "#/$defs/SketchReference"
              },
              "type": {
                "const": "midpoint",
                "type": "string"
              }
            },
            "required": [
              "type",
              "point",
              "line"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/ElementId"
          }
        },
        "required": [
          "id"
        ],
        "type": "object",
        "unevaluatedProperties": false
      },
      "SketchLine": {
        "additionalProperties": false,
        "description": "A line from one point to another.",
        "properties": {
          "construction": {
            "type": "boolean"
          },
          "from": {
            "$ref": "#/$defs/ElementId"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "to": {
            "$ref": "#/$defs/ElementId"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "construction"
        ],
        "type": "object"
      },
      "SketchPoint": {
        "additionalProperties": false,
        "description": "A point of the sketch, which curves share.",
        "properties": {
          "construction": {
            "description": "Construction geometry is solved like any other and left out of the profile (D7).",
            "type": "boolean"
          },
          "id": {
            "$ref": "#/$defs/ElementId"
          },
          "x": {
            "$ref": "#/$defs/Coordinate"
          },
          "y": {
            "$ref": "#/$defs/Coordinate"
          }
        },
        "required": [
          "id",
          "x",
          "y",
          "construction"
        ],
        "type": "object"
      },
      "SketchReference": {
        "description": "An element of this sketch, by its ID, or one of the fixed references every sketch has: origin, x_axis (from the origin along +x), y_axis (from the origin along +y).",
        "pattern": "^([0123456789abcdefghjkmnpqrstvwxyz]{8}|origin|x_axis|y_axis)$",
        "type": "string"
      },
      "TangentSide": {
        "description": "Where a tangent curve lies: for a line and a circle or arc, the side of the line the\ncurve is on (facing from its start to its end); for two circles or arcs, each outside\nthe other, or one inside the other.",
        "enum": [
          "left",
          "right",
          "outside",
          "inside"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`sketch_add`'s request: add members to a sketch, as the document writes them.",
    "properties": {
      "arcs": {
        "description": "The arcs to add.",
        "items": {
          "$ref": "#/$defs/SketchArc"
        },
        "type": "array"
      },
      "circles": {
        "description": "The circles to add.",
        "items": {
          "$ref": "#/$defs/SketchCircle"
        },
        "type": "array"
      },
      "constraints": {
        "description": "The constraints to add, naming the sketch's members, the members added, or the\nfixed references. One that conflicts with others, or repeats them, is added all the\nsame: the sketch then reads as over defined, and its features fail until it's mended.",
        "items": {
          "$ref": "#/$defs/SketchConstraint"
        },
        "type": "array"
      },
      "lines": {
        "description": "The lines to add: each may end at a point the sketch holds, which joins it to that\npoint's curves, or at one of the points added.",
        "items": {
          "$ref": "#/$defs/SketchLine"
        },
        "type": "array"
      },
      "points": {
        "description": "The points to add, each with an ID the sketch doesn't hold.",
        "items": {
          "$ref": "#/$defs/SketchPoint"
        },
        "type": "array"
      },
      "revision": {
        "description": "The session's revision the edit was made against: an edit against another is\nrefused as a `conflict`.",
        "minimum": 1,
        "type": "integer"
      },
      "session": {
        "description": "The session's ID, as `open` gave it.",
        "pattern": "^s[1-9][0-9]*$",
        "type": "string"
      },
      "sketch": {
        "$ref": "#/$defs/FeatureId",
        "description": "The sketch, by its feature's ID."
      }
    },
    "required": [
      "arcs",
      "circles",
      "constraints",
      "lines",
      "points",
      "revision",
      "session",
      "sketch"
    ],
    "title": "SketchAddRequest",
    "type": "object"
  },
  "result": {
    "$defs": {
      "CommitResult": {
        "additionalProperties": false,
        "description": "What a commit did: `commit`'s result, and the commit an edit made outside a transaction\nholds (each such edit is saved as its own transaction).",
        "properties": {
          "path": {
            "description": "The document's path, as `open` was given it.",
            "type": "string"
          },
          "problems": {
            "description": "What the commit couldn't fix, the first 100: failed features, and the drift of\nfeatures no edit reached, whose fingerprints it leaves as stored (only `format`\naccepts drift).",
            "items": {
              "$ref": "#/$defs/Error"
            },
            "maxItems": 100,
            "type": "array"
          },
          "problems_total": {
            "description": "How many problems there are, listed or not.",
            "minimum": 0,
            "type": "integer"
          },
          "refingerprinted": {
            "description": "The features the edits reached whose fingerprints were written anew, in timeline\norder.",
            "items": {
              "$ref": "#/$defs/FeatureId"
            },
            "type": "array"
          },
          "resolved": {
            "description": "The sketches the edits reached whose solves were written anew, in timeline order.",
            "items": {
              "$ref": "#/$defs/FeatureId"
            },
            "type": "array"
          },
          "written": {
            "description": "Whether the file was written: false when the document is the one the transaction\nbegan with.",
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "problems",
          "problems_total",
          "refingerprinted",
          "resolved",
          "written"
        ],
        "type": "object"
      },
      "ElementId": {
        "description": "A sketch element's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u), unique within its sketch.",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      },
      "Error": {
        "additionalProperties": false,
        "description": "Why a command was refused, or a problem it found, in Silico's error contract: a code, a\nmessage, and, where they apply, the feature, the elements at fault (the first of them, and\nhow many in all), the request's field at fault, the cause, what to do, and the names that\nmight have been meant. Every field is always present: null, or empty, where it doesn't\napply.",
        "properties": {
          "candidates": {
            "description": "What might have been meant, such as the names nearest one that found nothing.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cause": {
            "description": "What lay under it, such as the kernel's own failure, if known.",
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "description": "What kind of error it is: one of Silico's error codes, such as `invalid_input`.",
            "type": "string"
          },
          "elements": {
            "description": "The elements at fault, by name: the first of them, if there are many.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "elements_total": {
            "description": "How many elements are at fault, listed or not.",
            "minimum": 0,
            "type": "integer"
          },
          "feature": {
            "description": "The ID of the feature at fault, if one is.",
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "description": "What went wrong, in a sentence.",
            "type": "string"
          },
          "parameter": {
            "description": "The field at fault, as a dotted path (`position.2`), if one is.",
            "type": [
              "string",
              "null"
            ]
          },
          "suggestion": {
            "description": "What to do about it, if Silico can say.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "candidates",
          "cause",
          "code",
          "elements",
          "elements_total",
          "feature",
          "message",
          "parameter",
          "suggestion"
        ],
        "type": "object"
      },
      "FeatureId": {
        "description": "A feature's ID: 8 characters of Crockford's base32 in lower case (digits and letters but i, l, o, and u).",
        "pattern": "^[0123456789abcdefghjkmnpqrstvwxyz]{8}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`sketch_add`'s and `sketch_remove`'s result.",
    "properties": {
      "added": {
        "description": "The members added, in the order the edit made them: by kind (points, lines,\ncircles, arcs, constraints), each kind in the order given.",
        "items": {
          "$ref": "#/$defs/ElementId"
        },
        "type": "array"
      },
      "changed": {
        "description": "Whether the document changed: false for an empty batch, which makes no new revision\nand writes nothing.",
        "type": "boolean"
      },
      "commit": {
        "anyOf": [
          {
            "$ref": "#/$defs/CommitResult"
          },
          {
            "type": "null"
          }
        ],
        "description": "Outside a transaction, the commit that saved the edit; null inside one, or if\nnothing changed."
      },
      "modified": {
