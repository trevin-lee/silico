+  uint64_t Serial() const noexcept { return mySerial_; }
+
+  //! Silico: returns the next serial number (single-threaded use).
+  Standard_EXPORT static uint64_t NextSerial() noexcept;
+
+  //! Silico: sets the serial counter, e.g. at the start of each kernel request.
+  Standard_EXPORT static void SetSerialCounter(uint64_t theValue) noexcept;
