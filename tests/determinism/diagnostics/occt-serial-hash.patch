diff --git a/src/ModelingData/TKBRep/TopoDS/TopoDS_Shape.hxx b/src/ModelingData/TKBRep/TopoDS/TopoDS_Shape.hxx
index b9f5da9b..f4a7c0c6 100644
--- a/src/ModelingData/TKBRep/TopoDS/TopoDS_Shape.hxx
+++ b/src/ModelingData/TKBRep/TopoDS/TopoDS_Shape.hxx
@@ -333,10 +333,15 @@ struct hash<TopoDS_Shape>
 {
   size_t operator()(const TopoDS_Shape& theShape) const noexcept
   {
-    const size_t aHL = std::hash<TopLoc_Location>{}(theShape.Location());
-    return aHL == 0
-             ? opencascade::hash(theShape.TShape().get())
-             : opencascade::MurmurHash::hash_combine(theShape.TShape().get(), sizeof(void*), aHL);
+    // Silico: hash the TShape's creation serial, not its address.
+    const size_t   aHL = std::hash<TopLoc_Location>{}(theShape.Location());
+    const size_t   aHT = std::hash<occ::handle<TopoDS_TShape>>{}(theShape.TShape());
+    const uint64_t aS  = aHT;
+    // Located shapes hash by location only. Upstream hashes the TShape's first bytes (its
+    // vtable pointer, the same for every TShape of a type) with the location, so it never
+    // depended on which TShape it was; some algorithms rely on that.
+    (void)aS;
+    return aHL == 0 ? aHT : aHL;
   }
 };
 } // namespace std
