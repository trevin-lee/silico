diff --git a/src/FoundationClasses/TKernel/Standard/Standard_Handle.hxx b/src/FoundationClasses/TKernel/Standard/Standard_Handle.hxx
index 1dcd3a95..acd358a9 100644
--- a/src/FoundationClasses/TKernel/Standard/Standard_Handle.hxx
+++ b/src/FoundationClasses/TKernel/Standard/Standard_Handle.hxx
@@ -456,7 +456,10 @@ struct hash<Handle(TheTransientType)>
 {
   size_t operator()(const Handle(TheTransientType)& theHandle) const noexcept
   {
-    return static_cast<size_t>(reinterpret_cast<std::uintptr_t>(theHandle.get()));
+    // Silico: hash the creation serial, not the address. Unmixed on purpose: like the
+    // original identity hash of addresses, it keeps map iteration close to creation order,
+    // which some OCCT algorithms (e.g. BRepTools_Quilt) depend on.
+    return theHandle.get() == nullptr ? 0 : static_cast<size_t>(theHandle->Serial());
   }
 };
 } // namespace std
diff --git a/src/FoundationClasses/TKernel/Standard/Standard_Transient.cxx b/src/FoundationClasses/TKernel/Standard/Standard_Transient.cxx
index 81d0591d..5bef1baf 100644
--- a/src/FoundationClasses/TKernel/Standard/Standard_Transient.cxx
+++ b/src/FoundationClasses/TKernel/Standard/Standard_Transient.cxx
@@ -74,3 +74,19 @@ Standard_Transient* Standard_Transient::This() const
   }
   return const_cast<Standard_Transient*>(this);
 }
+
+// Silico: creation-order serial numbers for reproducible hashing.
+namespace
+{
+uint64_t THE_SERIAL_COUNTER = 0;
+}
+
+uint64_t Standard_Transient::NextSerial() noexcept
+{
+  return ++THE_SERIAL_COUNTER;
+}
+
+void Standard_Transient::SetSerialCounter(uint64_t theValue) noexcept
+{
+  THE_SERIAL_COUNTER = theValue;
+}
